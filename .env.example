# ==============================================================================
# INDIAN MARKET AI NEWS INTELLIGENCE PLATFORM — ENVIRONMENT CONFIGURATION
# ==============================================================================
# NOTE: Never commit actual secret keys or .env.local to GitHub.
# Copy this file to .env.local and fill in your actual values.

# --- SUPABASE CONFIGURATION ---
# Found in your Supabase project dashboard -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Server-side ONLY for background ingestion & administration (never exposed to client)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- AI PROVIDER CONFIGURATION ---
# Supported providers: "gemini" | "openai" | "anthropic" | "groq" | "ollama"
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_or_openai_api_key_here
AI_MODEL=gemini-2.0-flash

# --- INGESTION & CRON SECURITY ---
# Secret bearer token to authorize scheduled ingestion cron jobs (/api/cron/ingest)
CRON_SECRET=your_random_cron_secret_token_here

# --- APPLICATION SETTINGS ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Indian Market AI News Intelligence"
